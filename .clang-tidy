---
Checks: >-
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-suspicious-include,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

# Only report diagnostics from hand-written sources: the Makefile lint-tidy
# target's --header-filter selects src/tree_sitter_rst/; the generated
# src/parser.c is never analyzed.
FormatStyle: none
